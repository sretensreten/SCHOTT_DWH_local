  },
  "filters": {
    "name_contains": "",
    "name_starts_with": "",
    "dbt_tags": []
  },
  "reports": {
    "input_dir": "DWH/data_profiling/outputs/profiles/bigquery",
    "output_dir": "DWH/data_profiling/outputs/reports",
    "output_file": "data_profile_report.html",
    "title": "BigQuery Data Profile Report",
    "company_label": "DWH Data Profiling",
    "show_top_values_limit": 20
  },
  "cost_control": {
    "dry_run_before_execute": true,
