{
  "project_label": "dwh",
  "output_folder": "snapshot_dwh",
  "full_snapshot_file_name": "dwh_project_full_snapshot.txt",
  "exclude_dirs": [
    "snapshot",
    ".snapshot",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".venv",
    "venv",
    "env",
    "node_modules",
    ".git",
    ".kilo",
    ".vscode",
    ".docs"
  ],
  "exclude_files": [
    ".gitkeep",
    ".env",
    "local.env",
    "__init__.py",
    "package.json"
  ],
  "groups": {
    "dwh": {
      "dirs": [
        "DWH"
      ],
      "extensions": [
        ".py",
        ".ps1"
      ]
    },
    "runhub": {
      "dirs": [
        ".runhub",
        ".runhub.project"
      ],
      "extensions": [
        ".js",
        ".html",
        ".css",
        ".json"
      ]
    }
  },
  "agents": {
    "enabled": true,
    "output_file_name": "agents_snapshot.txt"
  }
}