{
  "project_label": "dwh",
  "output_folder": "snapshot_dwh",
  "full_snapshot_file_name": "dwh_project_full_snapshot.txt",
  "exclude_dirs": [
    "snapshot",
    ".snapshot",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".venv",
    "venv",
    ".venv-linux",
    "env",
    "node_modules",
    ".git",
    ".kilo",
    ".vscode",
    ".docs"
  ],
  "exclude_files": [
    ".gitkeep",
    ".env",
    "local.env",
    "__init__.py",
    "package.json"
  ],
  "groups": {
    "dwh": {
      "dirs": [
        "DWH"
      ],
      "extensions": [
        ".py",
        ".ps1",
        ".json"
      ],
      "include_folders": [],
      "exclude_folders": [
        "DWH/data_comparation/outputs",
        "DWH/data_comparation/config",
        
        "DWH/data_profiling/outputs"
      ],
      "include_files": [],
      "exclude_files": [],
      "output_file_name": "bigquery_dwh_python_snapshot.txt",
      "include_in_full_snapshot": true
    },
    "runhub": {
      "dirs": [
        ".runhub",
        ".runhub.project"
      ],
      "extensions": [
        ".js",
        ".html",
        ".css",
        ".json"
      ],
      "include_folders": [],
      "exclude_folders": [],
      "include_files": [],
      "exclude_files": [],
      "output_file_name": "bigquery_dwh_runhub_snapshot.txt",
      "include_in_full_snapshot": false
    },
    "profile": {
      "dirs": [
        "DWH/data_profiling/outputs/profiles/bigquery"
      ],
      "extensions": [
        ".json"
      ],
      "include_folders": [],
      "exclude_folders": [],
      "include_files": [],
      "exclude_files": ["_profile_summary.json"],
      "output_file_name": "bigquery_dwh_tables_profile_snapshot.txt",
      "include_in_full_snapshot": false
    },
    "snapshot": {
      "dirs": [
        ".snapshot"
      ],
      "extensions": [
        ".json",
        ".py"
      ],
      "include_folders": [],
      "exclude_folders": [],
      "include_files": [],
      "exclude_files": [],
      "output_file_name": "bigquery_dwh_script_for_snapshot.txt",
      "include_in_full_snapshot": false
    }
  },
  "agents": {
    "enabled": true,
    "groups": {
      "agents": {
        "output_file_name": "bigquery_dwh_agents_snapshot.txt",
        "include_files": [
          "**/AGENTS.md"
        ],
        "exclude_files": [],
        "include_in_full_snapshot": false
      },
      "claude": {
        "output_file_name": "bigquery_dwh_claude_snapshot.txt",
        "include_files": [
          "**/CLAUDE.md"
        ],
        "exclude_files": [],
        "include_in_full_snapshot": false
      }
    }
  }
}